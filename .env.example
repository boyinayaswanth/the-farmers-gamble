# ==========================================
# THE FARMER'S GAMBLE - ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/the_farmers_gamble?schema=public"

# Authentication & Session Security (JWT)
JWT_SECRET=tfg_super_secure_jwt_secret_key_2026_dev_mode

# Mandatory OTP Authentication (SMS Provider)
# Set OTP_PROVIDER to 'dev' for safe local development, or 'twilio' / 'exotel' for production
OTP_PROVIDER=dev
OTP_API_KEY=your_otp_api_key_or_twilio_sid
OTP_API_SECRET=your_otp_api_secret_or_twilio_token
OTP_SENDER_ID=FARMER
DEV_OTP_ENABLED=true

# AI Provider Configuration (AgriAI & Vision)
# Supported options: 'builtin' (Expert Agro Rule Engine), 'gemini', 'openai'
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Agro-Meteorology & Weather Provider
WEATHER_PROVIDER=demo
WEATHER_API_KEY=your_openweather_or_weatherapi_key_here

# APMC Mandi Market Data Provider
MARKET_PROVIDER=demo
MARKET_API_KEY=your_agmarknet_or_data_gov_in_api_key_here

# Telephony Architecture (Two-Way Voice AI & IVR)
# Compatible with Twilio Voice & Exotel Voice Webhooks
TELEPHONY_PROVIDER=dev
TELEPHONY_ACCOUNT_ID=your_twilio_account_sid
TELEPHONY_AUTH_TOKEN=your_twilio_auth_token
TELEPHONY_PHONE_NUMBER=+918047195000
